APP_NAME=HealNexus AI Service
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8001

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exa — never commit real keys; never send to the browser
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_SECONDS=20

# Optional Supabase (read-only enrichment later — no CRUD APIs here)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Future ML service hook (leave empty until models are ready)
ML_INFERENCE_URL=
LOG_LEVEL=INFO
