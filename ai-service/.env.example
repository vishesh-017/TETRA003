APP_NAME=HealNexus AI Service
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8001

# Comma-separated browser origins (add every Vercel URL you deploy)
# *.vercel.app is also allowed via regex in app/main.py
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR_APP.vercel.app

# Exa — never commit real keys; never send to the browser
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
EXA_TIMEOUT_SECONDS=20

# OpenRouter — LLM assistive synthesis (server-side only; never expose to Vite)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_SITE_URL=http://127.0.0.1:5173
OPENROUTER_APP_NAME=HealNexus

# Optional Supabase (read-only enrichment later — no CRUD APIs here)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Future ML service hook (leave empty until models are ready)
ML_INFERENCE_URL=
LOG_LEVEL=INFO
