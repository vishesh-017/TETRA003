# =============================================================================
# HealNexus — Git ignore
# =============================================================================

# ----- Dependencies -----
node_modules/
webapp/node_modules/
ai-service/.venv/
.venv/
venv/
env/
ENV/

# ----- Environment & secrets (keep *.example) -----
.env
.env.*
!.env.example
!**/.env.example
webapp/.env
webapp/.env.local
webapp/.env.*.local
ai-service/.env
ai-service/.env.local
*.pem
*.key
secrets/
credentials*.json
service-account*.json

# ----- Build / compile outputs -----
webapp/dist/
webapp/dist-ssr/
webapp/build/
*.egg-info/
*.egg
.eggs/
*.tsbuildinfo

# ----- Local databases & runtime data -----
*.db
*.db-journal
*.sqlite
*.sqlite3
data/local/

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ----- Node / package managers -----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Logs -----
logs/
*.log
webapp/logs/
ai-service/logs/

# ----- Testing / coverage -----
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# ----- IDE / editors -----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- OS junk -----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Caches / tooling -----
.cache/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
*.local
webapp/.vite/

# ----- Optional local override dirs -----
.tmp/
.temp/
scratch/

# ----- Legacy folder name (if a locked copy remains) -----
frontend/
